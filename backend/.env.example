# ---------------------------------------------------------------------------
# LeetDecode backend environment variables
# Copy to `.env` for local development:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Provider credentials -------------------------------------------------
# You need a key for whichever provider(s) you enable below.

# Google Gemini. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# xAI Grok. Get one at https://console.x.ai/
XAI_API_KEY=

# --- Provider selection ---------------------------------------------------
# LLM_PROVIDER serves every translation. If it errors (network, auth, rate
# limit) or returns JSON that fails schema validation, LLM_FALLBACK_PROVIDER
# gets exactly one retry. Leave the fallback blank to disable failover.
# Valid values: gemini | grok
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=grok

# --- Models (defaults shown) ----------------------------------------------
# gemini-3.1-flash-lite  $0.25/1M in,  $1.50/1M out  - cheapest current tier
# grok-4.3               $1.25/1M in,  $2.50/1M out, 1M context
GEMINI_MODEL=gemini-3.1-flash-lite
GROK_MODEL=grok-4.3

# Max output tokens for a single translation.
LLM_MAX_TOKENS=2000

# --- Database -------------------------------------------------------------
# Required from step 5 onward.
# Local example: postgresql://postgres:postgres@localhost:5432/leetdecode
# Railway injects this automatically as DATABASE_URL when you attach Postgres.
DATABASE_URL=

# --- Optional overrides ---------------------------------------------------

# Free LLM-generated translations allowed per anonymous install.
FREE_CALL_LIMIT=5

# Comma-separated allowed CORS origins. "*" allows any origin, which is what
# you want for a Chrome extension popup (its origin is chrome-extension://<id>
# and that id changes between unpacked dev loads and the Web Store build).
CORS_ALLOW_ORIGINS=*

# Set to "false" to stop the daily-problem APScheduler job from starting
# (useful when running multiple instances, or in local dev).
ENABLE_SCHEDULER=true
