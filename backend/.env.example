# ---------------------------------------------------------------------------
# LeetDecode backend environment variables
# Copy to `.env` for local development:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Provider credentials -------------------------------------------------
# You need a key for whichever provider(s) you enable below.

# Google Gemini. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (GroqCloud). Get one at https://console.groq.com/keys
GROQ_API_KEY=

# --- Provider selection ---------------------------------------------------
# LLM_PROVIDER serves every translation. If it errors (network, auth, rate
# limit) or returns JSON that fails schema validation, LLM_FALLBACK_PROVIDER
# gets exactly one retry. Leave the fallback blank to disable failover.
# Valid values: gemini | groq
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq

# --- Models (defaults shown) ----------------------------------------------
# gemini-3.1-flash-lite  $0.25/1M in,  $1.50/1M out  - cheapest Gemini tier
# openai/gpt-oss-120b    $0.15/1M in,  $0.60/1M out, 131k ctx, on Groq
#   cheaper swap: openai/gpt-oss-20b  $0.075/1M in, $0.30/1M out
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=openai/gpt-oss-120b

# Max output tokens for a single translation.
LLM_MAX_TOKENS=2000

# Hard ceiling on a single provider call, in seconds. A hung upstream would
# otherwise hold a worker thread; with failover configured we'd rather give up
# early and try the other provider.
LLM_TIMEOUT_SECONDS=45

# --- Database -------------------------------------------------------------
# Required from step 5 onward.
# Local example: postgresql://postgres:postgres@localhost:5432/leetdecode
# Railway injects this automatically as DATABASE_URL when you attach Postgres.
DATABASE_URL=

# --- Optional overrides ---------------------------------------------------

# Free LLM-generated translations allowed per anonymous install.
FREE_CALL_LIMIT=5

# --- Abuse / cost protection -----------------------------------------------
# install_id is generated client-side and unauthenticated, so FREE_CALL_LIMIT
# alone is trivially reset by minting a new UUID. These are the backstop that
# makes /translate safe to expose publicly. Set to false only for local dev.
RATE_LIMITS_ENABLED=true

# Every request from one IP, per hour. Generous volumetric brake.
RATE_LIMIT_REQUESTS_PER_HOUR=120

# Cache *misses* from one IP, per hour. The real cost brake - only a miss
# reaches a provider. Cache hits are never counted.
RATE_LIMIT_LLM_PER_HOUR=20

# New install_ids registered from one IP, per hour. This closes the
# quota-reset vector: fresh UUIDs stop being free after a few.
RATE_LIMIT_NEW_INSTALLS_PER_HOUR=3

# Hard ceiling on LLM calls per day across all users. On hitting it the service
# stays up in cache-only mode and returns 503 AT_CAPACITY for new generations,
# so the bill can never exceed a number you set.
# ~1000 calls is roughly $0.50-0.75/day at the default models.
LLM_DAILY_CAP=1000

# Comma-separated allowed CORS origins. "*" allows any origin, which is what
# you want for a Chrome extension popup (its origin is chrome-extension://<id>
# and that id changes between unpacked dev loads and the Web Store build).
CORS_ALLOW_ORIGINS=*

# --- Admin dashboard -------------------------------------------------------
# Bearer token for /admin. Leave EMPTY to disable the dashboard entirely -
# unset means closed, never open. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- Observability ---------------------------------------------------------
# Sentry error tracking. Leave empty to disable entirely - the app runs fine
# without it. Free tier: https://sentry.io
SENTRY_DSN=

# Tags events so you can tell production from local. Also switches logging to
# single-line JSON when set to anything other than "development".
SENTRY_ENVIRONMENT=development

# Fraction of requests traced for performance data (0.0-1.0).
SENTRY_TRACES_SAMPLE_RATE=0.1

# Sends request headers and client IPs to Sentry. Off by default on purpose:
# the SRS commits to collecting only an anonymous install ID and the pasted
# problem text, and enabling this changes what your privacy policy must
# disclose. Pasted text is scrubbed from error payloads either way.
SENTRY_SEND_PII=false

# Set to "false" to stop the daily-problem APScheduler job from starting
# (useful when running multiple instances, or in local dev).
ENABLE_SCHEDULER=true

# Hour (UTC) at which the daily-problem job runs. A fixed wall-clock time, not
# an interval, so redeploys don't keep resetting the countdown.
DAILY_JOB_HOUR=3
